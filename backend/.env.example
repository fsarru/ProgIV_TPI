# Conexión a la base. Desarrollo local (SQLite): sqlite:///./foodstore.db
# PostgreSQL: postgresql://usuario:clave@localhost:5432/foodstore_db
DATABASE_URL=sqlite:///./foodstore.db

# Firma del JWT: mínimo 32 caracteres. Generar una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen del frontend permitido en CORS (con credenciales)
FRONTEND_ORIGIN=http://localhost:5173

# true solo cuando la API se sirve por HTTPS
COOKIE_SECURE=false
